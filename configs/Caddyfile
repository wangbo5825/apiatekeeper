# apigate 网关配置（基于 FRAMPP：FrankenPHP + caddy-access-filter + Souin）
#
# 拓扑遵循 caddy-access-filter 的 examples/php-worker/Caddyfile：
#   - /__proc/request 处理器端点：PHP worker，绝不套 access/filter
#   - /admin/api/*    管理端 API：PHP worker，无钩子，应用层令牌鉴权
#   - /admin/*        SPA 静态资源
#   - 其余请求        网关链路：access → filter → cache → reverse_proxy
#
# 说明：
#   - 若部署构建未包含 Souin，可注释全局 cache 块与路由中的 cache 指令
#   - stream 模式示例见下方 /sse 路由（filter mode stream）
#   - 动态上游：access 输出 X-Processor-Backend（上游目标地址），
#     下方 map 消费它；无提示时回落到 APIGATE_UPSTREAM

{
	admin off
	auto_https off

	# Souin 全局缓存配置（语法随 Souin 版本，按实际构建版本校验）
	order cache before rewrite
	cache {
		ttl 60s
		default_cache_control no-store
	}
}

:8080 {
	root * .

	# ── 1) 处理器端点：PHP worker 契约实现（phase=access/filter）──
	#    仅允许本机回环访问，并注入共享密钥供 worker 校验。
	handle /__proc/request {
		@external not remote_ip 127.0.0.0/8 ::1
		respond @external 403
		# 注意：设置“请求头”必须用 request_header 指令（header 只处理响应头）
		request_header X-Processor-Secret "{env.APIGATE_PROCESSOR_SECRET}"
		php {
			root .
			worker {
				file ./processor/worker.php
				match /__proc/request
			}
		}
	}

	# ── 2) 管理端 API：PHP worker（无 access/filter，避免递归）──
	@adminApi {
		path /admin/api /admin/api/*
	}
	handle @adminApi {
		php {
			root .
			worker {
				file ./processor/worker.php
				match /admin/api/*
			}
		}
	}

	# ── 3) 管理端 SPA 静态资源 ──
	#    SPA 按 base=/admin/ 构建，资源请求形如 /admin/assets/...；
	#    因此 /admin 先重定向到 /admin/，/admin/* 用 handle_path 剥离前缀后
	#    再以 dist 为根提供文件（try_files 兜底 SPA 路由回 index.html）。
	handle /admin {
		# 注意：Caddy 的 redir 语法是 [<matcher>] <to> [<code>]，
		# 直接写 redir /admin/ 308 会被解析成 from=/admin/ to=308（302）。
		# 用 * 匹配器 + 显式目标，才能表达"重定向到 /admin/，状态 308"。
		redir * /admin/ 308
	}
	handle_path /admin/* {
		# try_files 的文件匹配器与 file_server 都读 {http.vars.root}，
		# 必须在此作用域内设置 root，否则回退路径按站点根目录解析会 404。
		root * ./admin-web/dist
		try_files {path} /index.html
		file_server {
			index index.html
		}
	}

	# ── 4) SSE 示例路由：filter 使用 stream 模式，不缓冲 ──
	handle /sse {
		route {
			access {
				upstream http://127.0.0.1:8080
				path /__proc/request
				timeout 1s
				on_error passthrough
			}
			filter {
				mode stream
				upstream http://127.0.0.1:8080
				path /__proc/request
				timeout 1s
				on_error passthrough
			}
			reverse_proxy {env.APIGATE_UPSTREAM}
		}
	}

	# ── 5) 默认网关路由：access → filter → cache → reverse_proxy ──
	handle {
		route {
			access {
				upstream http://127.0.0.1:8080
				path /__proc/request
				timeout 1s
				on_error passthrough
			}
			filter {
				mode buffer
				upstream http://127.0.0.1:8080
				path /__proc/request
				timeout 1s
				on_error passthrough
			}
			cache
			# 注意：map 目标不能用 {vars.*}/{http.vars.*}——Caddy 的
			# {http.vars.*} replacer 对未设置变量也总是返回空值，会挡住 map 的
			# 懒回调导致上游恒为空（dial tcp :0）。用自定义占位符 {gk_upstream}。
			map {http.request.header.X-Processor-Backend} {gk_upstream} {
				# 必须加非空正则透传：map 只会按映射项输出，没有映射时恒返回
				# default（导致应用上游配置不生效、永远走兜底）。
				# ~.+ 匹配任意非空值，$0 = 整个匹配（原样透传）。
				~.+ $0
				default {env.APIGATE_UPSTREAM}
			}
			# Caddy 动态上游限制：占位符地址不能带 scheme，值必须是 host:port
			reverse_proxy {gk_upstream}
		}
	}
}
